---
import "../styles/system.css";
import Head from "../components/Head.astro";

export interface Props {
  title: string;
  description: string;
  ogImageUrl?: string;
}

const { title, description, ogImageUrl } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {title} {description} {ogImageUrl} preloadFonts>
      <slot name="head" />
    </Head>
  </head>
  <body>
    <slot />
  </body>
</html>
