---
import "../styles/global.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  ogImageUrl?: string;
  size?: "default" | "wide" | "full";
}

let { title, description, ogImageUrl, size = "full" } = Astro.props as Props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <Head {title} {description} {ogImageUrl}>
      <link
        rel="preload"
        href="/fonts/IBM_Plex_Sans/IBMPlexSans-Regular.ttf"
        crossorigin="anonymous"
        as="font"
        type="font/ttf"
      />
      <link
        rel="preload"
        href="/fonts/IBM_Plex_Sans/IBMPlexSans-SemiBold.ttf"
        crossorigin="anonymous"
        as="font"
        type="font/ttf"
      />
    </Head>
  </head>

  <body
    class="text flex h-full flex-col"
    class:list={[
      size === "full" ? "" : "container",
      size === "default" ? "max-w-2xl" : "",
    ]}
  >
    <Header />
    <div class={`mb-48 flex-1 container mx-auto px-8`}>
      <slot />
    </div>
    <Footer />
  </body>
</html>
