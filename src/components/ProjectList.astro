---
import type { Project } from "../content.config";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;
---

<div class="grid items-start gap-12 md:grid-cols-3">
  {
    projects
      .filter((project) => !project.data.draft)
      // The glob loader's order isn't guaranteed; this keeps waveformr first.
      .toSorted((a, b) => b.id.localeCompare(a.id))
      .map((project) => <ProjectPreview {project} />)
  }
</div>
