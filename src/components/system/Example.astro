---
// A live example inside a post: something the reader watches or uses, set
// on the code block's recessed ground. Several children stack inside one.
interface Props {
  label?: string;
  /** Run across the margin too, on screens wide enough to have one */
  wide?: boolean;
}

const { label = "example", wide = false } = Astro.props;
---

<figure class:list={["example", { wide }]}>
  <figcaption>{label}</figcaption>
  <div class="stage">
    <slot />
  </div>
</figure>

<style>
  .example {
    background: var(--ground-2);
    border-radius: var(--radius-block);
  }

  figcaption {
    padding: var(--space-3) 1.25rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-note);
    font-size-adjust: var(--adjust-mono);
    line-height: var(--leading-note);
    color: var(--muted);
  }

  .stage {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6) 1.25rem;
  }

  /* An example is live UI, not text: the post's block rhythm stays out */
  :global(.prose) .stage :global(*) {
    margin-top: 0;
  }
</style>
