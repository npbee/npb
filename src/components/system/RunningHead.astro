---
export type Section = "about" | "projects" | "posts" | "demos";

interface Props {
  current?: Section;
}

const { current } = Astro.props;

const sections: Section[] = ["about", "projects", "posts", "demos"];
---

<header class="head">
  <a class="wordmark" href="/">
    <span>nick</span> <span>ball</span>
  </a>
  <nav aria-label="Sections">
    <ul>
      {sections.map((name) => (
        <li>
          <a
            href={`/${name}`}
            aria-current={name === current ? "page" : undefined}
            style={`--led: var(--${name})`}
            data-section-link={name}
          >
            <span class="light" aria-hidden="true" />
            {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .head {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: 0.625rem;
    border-bottom: var(--hair) solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .wordmark {
    justify-self: start;
    font-size: var(--text-mono);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--muted);
  }

  nav a[aria-current] {
    color: var(--ink);
  }

  @media (hover: hover) {
    nav a:hover {
      color: var(--ink);
    }
  }

  .light {
    width: var(--light);
    height: var(--light);
    border-radius: 50%;
    background: var(--rule);
  }

  [aria-current] .light {
    background: var(--led);
    box-shadow:
      inset 0 0 0 var(--hair) var(--light-edge, transparent),
      0 0 0 3px color-mix(in srgb, var(--led) 28%, transparent);
  }

  /* The white demos knob needs an edge to read on paper */
  [data-section-link="demos"] {
    --light-edge: var(--muted);
  }

  /* Stack on the axis rather than let the nav wrap ragged */
  @media (max-width: 36rem) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 0.625rem;
    }
    .wordmark {
      justify-self: center;
    }
    ul {
      justify-content: center;
    }
  }
</style>
