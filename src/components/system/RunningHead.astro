---
export type Section = "about" | "projects" | "posts" | "demos";

interface Props {
  current?: Section;
}

const { current } = Astro.props;

const sections: Section[] = ["about", "projects", "posts", "demos"];
---

<header class="head">
  <a class="wordmark" href="/">
    <span>nick</span> <span>ball</span>
  </a>
  <nav aria-label="Sections">
    <ul>
      {sections.map((name) => (
        <li>
          <a
            href={`/${name}`}
            aria-current={name === current ? "page" : undefined}
            style={`--led: var(--${name})`}
            data-section-link={name}
          >
            <span class="light" aria-hidden="true" />
            {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .head {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: 0.625rem;
    border-bottom: var(--hair) solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--leading-mono);
  }

  /* One size with the nav; weight and ink tell them apart */
  .wordmark {
    justify-self: start;
  }

  /* Items sit four times further apart than a light sits from its label,
     so each light reads as part of its word */
  ul {
    --nav-gap: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--nav-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: inline-flex;
    /* Baseline, so the link's baseline is its text's and it lines up with
       the wordmark; centering would hand it the light's bottom edge. */
    align-items: baseline;
    gap: 0.375rem;
    color: var(--muted);
  }

  /* A 46px-tall hit area that stops halfway to each neighbor; on a
     pseudo-element, so the focus ring still hugs the word */
  nav a::after {
    content: "";
    position: absolute;
    inset: -0.75rem calc(var(--nav-gap) / -2);
  }

  nav a[aria-current] {
    color: var(--ink);
  }

  .light {
    align-self: center;
    /* the line box's center sits 1px above the x-height's; drop to meet it */
    translate: 0 0.0625rem;
    width: var(--light);
    height: var(--light);
    border-radius: 50%;
    background: var(--rule);
  }

  /* Hovering lights the section's color, a preview of where it goes */
  @media (hover: hover) {
    nav a:hover {
      color: var(--ink);
    }
    nav a:hover .light {
      background: var(--led);
      box-shadow: inset 0 0 0 var(--hair) var(--light-edge, transparent);
    }
  }

  [aria-current] .light {
    background: var(--led);
    box-shadow:
      inset 0 0 0 var(--hair) var(--light-edge, transparent),
      0 0 0 3px color-mix(in srgb, var(--led) 28%, transparent);
  }

  /* The white demos knob needs an edge to read on paper */
  [data-section-link="demos"] {
    --light-edge: var(--muted);
  }

  /* Stack rather than let the nav wrap ragged; left, like the page below */
  @media (max-width: 36rem) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    ul {
      --nav-gap: var(--space-4);
      justify-content: flex-start;
    }
  }
</style>
