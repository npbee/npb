---
import { fullDate, isoDate } from "../../utils/dates";

interface Props {
  title: string;
  description?: string;
  date: Date;
}

const { title, description, date } = Astro.props;

// Keep hyphenated words whole; "Type-" at a line end reads as a typo
const titleParts = title
  .split(/(\s+)/)
  .map((part) => ({ part, whole: part.includes("-") }));
---

<header class="post-head">
  <h1>
    {titleParts.map(({ part, whole }) =>
      whole ? <span class="whole">{part}</span> : part,
    )}
  </h1>
  {description && <p class="description">{description}</p>}
  <p class="date">
    <time datetime={isoDate(date)}>{fullDate(date)}</time>
  </p>
  <span class="rule" aria-hidden="true"></span>
</header>

<style>
  /* The body's column, so the header starts on the same left edge as the text */
  .post-head {
    width: 100%;
    max-width: var(--measure);
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  /* Set exactly like a page title, and first under the running head, so a
     post opens at the same height and size as the posts index */
  h1 {
    font-family: var(--font-mono);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .whole {
    white-space: nowrap;
  }

  .description {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--leading-mono);
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Metadata sits close under the description, as one group */
  .date {
    margin-top: calc(var(--space-1) - var(--space-3));
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .rule {
    width: 3rem;
    height: var(--bar);
    margin-top: var(--space-3);
    background: var(--accent);
  }
</style>
