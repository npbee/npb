---
// Short items outside a post, in an order the author chose. Numbers are
// drawn by CSS counters, so the list stays a plain <ol> for assistive
// technology.
import SectionLabel from "./SectionLabel.astro";

interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
const id = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<section class="rows numbered-list" aria-labelledby={id}>
  <SectionLabel {id}>{title}</SectionLabel>
  <ol>
    {items.map((item) => <li>{item}</li>)}
  </ol>
</section>

<style>
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: item;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-row);
    line-height: var(--leading-row);
  }

  li {
    counter-increment: item;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
  }

  li::before {
    content: counter(item, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-note);
    font-size-adjust: var(--adjust-mono);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
