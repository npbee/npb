---
// The running head's mirror: one rule, links on the left, theme on the right
const links = [
  ["github", "https://github.com/npbee"],
  ["twitter", "https://twitter.com/_nickball"],
  ["linkedin", "https://www.linkedin.com/in/niball"],
  ["rss", "/rss.xml"],
];
---

<footer class="foot">
  <ul aria-label="Find me">
    {links.map(([name, href]) => (
      <li>
        <a href={href}>{name}</a>
      </li>
    ))}
  </ul>
  <button
    type="button"
    class="theme"
    aria-label="Switch between light and dark"
    data-theme-toggle
  >
    <span class="option opt-light">light</span>
    <span class="slash" aria-hidden="true">
      /
    </span>
    <span class="option opt-dark">dark</span>
  </button>
</footer>

<style>
  .foot {
    width: 100%;
    margin-top: var(--space-4);
    padding-top: 0.625rem;
    border-top: var(--hair) solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--leading-mono);
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Flex, so markup whitespace can't push a dot off center */
  li {
    display: flex;
    align-items: baseline;
  }

  li + li::before {
    content: "·" / "";
    margin-inline: 0.5em;
  }

  /* 46px-tall hit areas that don't move anything */
  a {
    display: inline-block;
  }

  a,
  .theme {
    padding-block: 0.75rem;
    margin-block: -0.75rem;
  }

  .theme {
    display: inline-flex;
    gap: 0.5em;
    padding-inline: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--muted);
  }

  :global(:root:not([data-theme="dark"])) .opt-light,
  :global(:root[data-theme="dark"]) .opt-dark {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: var(--hair);
    text-underline-offset: 0.2em;
  }

  @media (hover: hover) {
    a:hover,
    .theme:hover .option {
      color: var(--ink);
    }
  }

  @media (max-width: 36rem) {
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        root.classList.toggle("dark", next === "dark");
        try {
          localStorage.setItem("theme", next);
        } catch {}
      }),
    );
</script>
