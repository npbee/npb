---
import type { Post } from "../../content.config";
import { isoDate, monthDay, yearMonth } from "../../utils/dates";

interface Props {
  /** Newest first */
  posts: Post[];
  /** Group under a year column; ungrouped rows show the year in the date */
  group?: boolean;
}

const { posts, group = true } = Astro.props;

const groups = group
  ? posts.reduce<{ year: number; posts: Post[] }[]>((acc, post) => {
      const year = post.data.date.getUTCFullYear();
      const last = acc.at(-1);
      if (last?.year === year) last.posts.push(post);
      else acc.push({ year, posts: [post] });
      return acc;
    }, [])
  : [{ year: null, posts }];
---

<div class:list={["index", { grouped: group }]}>
  {groups.map((g) => (
    <section aria-labelledby={g.year ? `year-${g.year}` : undefined}>
      {g.year && (
        <h2 class="year" id={`year-${g.year}`}>
          {g.year}
        </h2>
      )}
      <ul>
        {g.posts.map((post) => (
          <li>
            <a class="row" href={`/posts/${post.id}`}>
              <span class="title">{post.data.title}</span>
              <span class="leader" aria-hidden="true" />
              <time datetime={isoDate(post.data.date)}>
                {group ? monthDay(post.data.date) : yearMonth(post.data.date)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Spans the sheet, so years share the wordmark's edge and dates the nav's */
  .index {
    width: 100%;
    display: grid;
    gap: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--leading-mono);
  }

  section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  .grouped section {
    grid-template-columns: 5rem minmax(0, 1fr);
  }

  /* Same box as a row, so the year sits on its first row's baseline */
  .year {
    padding-block: 0.25rem;
    font-size: inherit;
    font-weight: 700;
    line-height: inherit;
    font-variant-numeric: tabular-nums;
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    gap: var(--space-2);
    /* a wrapped title keeps its leader and date on the last line */
    align-items: last baseline;
    padding-block: 0.25rem;
  }

  .title {
    min-width: 0;
  }

  /* Spaced dots rather than a dotted border, so a column of leaders reads
     as a path for the eye, not as more rules. An empty box's baseline is its
     bottom edge, so the dots sit on the text's baseline. */
  .leader {
    flex: 1;
    min-width: var(--space-4);
    height: 0.125rem;
    background-image: radial-gradient(
      circle at 0.0625rem 0.0625rem,
      var(--muted) 0.0469rem,
      transparent 0.0625rem
    );
    background-size: 0.375rem 0.125rem;
    background-repeat: repeat-x;
    /* anchored at the dates, which share a width, so dots line up row to row */
    background-position: right bottom;
  }

  time {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* hover only where it exists, so a tap doesn't leave a title colored */
  @media (hover: hover) {
    .row:hover .title {
      color: var(--accent-ink);
    }
  }

  /* A year column would squeeze titles on phones, so the year sits above.
     The leader gives way entirely before it makes a title wrap. */
  @media (max-width: 36rem) {
    .grouped section {
      grid-template-columns: minmax(0, 1fr);
    }
    .leader {
      min-width: 0;
    }
  }
</style>
