---
// The sheet every inner page sits on: one reading-width column, framed only
// by the running head and running foot rules, so the nav, the text and the
// footer share both edges.
---

<div class="sheet">
  <slot />
</div>

<style>
  .sheet {
    --margin: clamp(0.875rem, 4vw, 2.5rem);
    --pad: clamp(1rem, 5vw, 3.5rem);
    width: min(var(--measure) + 2 * var(--pad), 100% - 2 * var(--margin));
    margin: var(--margin) auto;
    padding-block: clamp(1.5rem, 6vw, 3.75rem);
    padding-inline: var(--pad);
    display: grid;
    justify-items: center;
    gap: var(--space-12);
  }
</style>
