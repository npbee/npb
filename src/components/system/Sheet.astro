---
// The sheet every inner page sits on: a centered column framed only by
// the running head and running foot rules.
---

<div class="sheet">
  <slot />
</div>

<style>
  .sheet {
    --margin: clamp(0.875rem, 4vw, 2.5rem);
    width: min(var(--sheet), 100% - 2 * var(--margin));
    margin: var(--margin) auto;
    padding-block: clamp(1.5rem, 6vw, 3.75rem);
    padding-inline: clamp(1rem, 5vw, 3.5rem);
    display: grid;
    justify-items: center;
    gap: var(--space-12);
  }
</style>
