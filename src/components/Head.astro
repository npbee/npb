---
import { Font } from "astro:assets";

export interface Props {
  title: string;
  description: string;
  ogImageUrl?: string | URL;
  /** Preload the faces a page sets above the fold, so text doesn't reflow
      when they arrive. Only pages that use them should. */
  preloadFonts?: boolean;
}

const {
  title,
  description,
  ogImageUrl = new URL("/og-image.png", Astro.url),
  preloadFonts = false,
} = Astro.props;

// Above the fold: the wordmark (mono 500), the nav, margin and body (mono
// 400) and titles (Newsreader 500)
const monoPreload = preloadFonts
  ? [
      { weight: 400, style: "normal" as const },
      { weight: 500, style: "normal" as const },
    ]
  : false;
const titlePreload = preloadFonts
  ? [{ weight: 500, style: "normal" as const }]
  : false;
const url = Astro.url;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Google / Search Engine Tags -->
<meta itemprop="image" content={ogImageUrl} />
<meta itemprop="name" content={title} />
<meta itemprop="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:creator" content="_nickball" />

<link
  rel="icon"
  type="image/png"
  href="/favicon/favicon-32x32.png"
  sizes="32x32"
/>
<link
  rel="icon"
  type="image/png"
  href="/favicon/favicon-96x96.png"
  sizes="96x96"
/>
<link
  rel="icon"
  type="image/png"
  href="/favicon/favicon-16x16.png"
  sizes="16x16"
/>

<Font cssVariable="--font-plex-mono" preload={monoPreload} />
<Font cssVariable="--font-newsreader" preload={titlePreload} />

<slot />

<!-- Runs before first paint so the page never shows the wrong theme.
     data-theme drives tokens.css. -->
<script is:inline>
  (() => {
    let theme = null;
    try {
      theme = localStorage.getItem("theme");
    } catch {}
    if (theme !== "light" && theme !== "dark") {
      theme = matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    const root = document.documentElement;
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  })();
</script>

{import.meta.env.PROD ? (
  <script
    defer
    src="/stats/script.js"
    data-website-id="52e31176-fde6-4d26-b38f-e83577f30d7b"
  />
) : null}
