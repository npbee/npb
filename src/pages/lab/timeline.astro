---
// Dev-only generator for the about page's timeline. Nothing in production
// imports this page; the about page reads the saved config instead.
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import career from "../../data/career.json";

if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const posts = (await getCollection("blog")).map((p) =>
  p.data.date.toISOString().slice(0, 7),
);
const now = new Date().toISOString().slice(0, 10);
const input = JSON.stringify({ career, posts, now });
---

<Page title="Timeline lab" description="Timeline generator" section="about">
  <div class="lab" data-input={input}>
    <section class="canvas" title="Click for a new variation">
      <div class="frame h">
        <p class="cap">desktop · 640</p>
        <div id="h"></div>
      </div>
    </section>
    <aside class="panel">
      <div class="tabs" id="modes"></div>
      <div class="row seed">
        <span>seed <b id="seed"></b></span>
        <button id="theme" type="button">theme</button>
      </div>
      <div id="knobs"></div>
      <div class="row">
        <button id="save" type="button" class="primary">save</button>
        <button id="copy" type="button">copy json</button>
      </div>
      <p id="saved" class="note"></p>
      <p class="cap">saved</p>
      <ol id="rail"></ol>
    </aside>
  </div>
</Page>

<script>
  import { render, defaultConfig, type TimelineConfig } from "../../components/timeline/render";
  import { knobs, MODES, randomize } from "../../components/timeline/knobs";

  const lab = document.querySelector<HTMLElement>(".lab")!;
  const input = JSON.parse(lab.dataset.input!);
  const $ = (id: string) => document.getElementById(id)!;

  let config: TimelineConfig = { ...defaultConfig };
  try {
    const kept = localStorage.getItem("timeline-lab");
    if (kept) config = { ...defaultConfig, ...JSON.parse(kept) };
  } catch {}

  function draw() {
    $("h").innerHTML = render(input, config);
    $("seed").textContent = String(config.seed);
    try {
      localStorage.setItem("timeline-lab", JSON.stringify(config));
    } catch {}
  }

  function buildModes() {
    $("modes").innerHTML = "";
    for (const m of MODES) {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = m;
      b.setAttribute("aria-pressed", String(config.mode === m));
      b.onclick = () => {
        config = { ...config, mode: m };
        sync();
      };
      $("modes").append(b);
    }
  }

  function buildKnobs() {
    const root = $("knobs");
    root.innerHTML = "";
    for (const { folder, items } of knobs) {
      const fs = document.createElement("fieldset");
      fs.innerHTML = `<legend>${folder}</legend>`;
      for (const k of items) {
        const row = document.createElement("label");
        row.className = "knob";
        // Every row stays; knobs for other modes dim rather than vanish
        if (k.modes && !k.modes.includes(config.mode)) row.classList.add("idle");
        const value = (config as any)[k.key];
        let control: HTMLInputElement | HTMLSelectElement;
        if (k.type === "range") {
          const i = document.createElement("input");
          Object.assign(i, { type: "range", min: k.min, max: k.max, step: k.step, value });
          i.oninput = () => {
            (config as any)[k.key] = Number(i.value);
            out.textContent = i.value;
            draw();
          };
          control = i;
        } else if (k.type === "select") {
          const s = document.createElement("select");
          for (const o of k.options) s.add(new Option(String(o), String(o), false, o === value));
          s.onchange = () => {
            const o = k.options.find((o) => String(o) === s.value)!;
            (config as any)[k.key] = o;
            draw();
          };
          control = s;
        } else {
          const i = document.createElement("input");
          i.type = "checkbox";
          i.checked = value;
          i.onchange = () => {
            (config as any)[k.key] = i.checked;
            draw();
          };
          control = i;
        }
        const name = document.createElement("span");
        name.textContent = k.key;
        const out = document.createElement("output");
        out.textContent = k.type === "range" ? String(value) : "";
        row.append(name, control, out);
        fs.append(row);
      }
      root.append(fs);
    }
  }

  function sync() {
    buildModes();
    buildKnobs();
    draw();
  }

  function rail(saves: { savedAt: string; config: TimelineConfig }[]) {
    $("rail").innerHTML = "";
    for (const s of saves) {
      const li = document.createElement("li");
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = `${s.config.mode} · ${s.config.seed} · ${s.savedAt.slice(5, 16).replace("T", " ")}`;
      b.onclick = () => {
        config = { ...defaultConfig, ...s.config };
        sync();
      };
      li.append(b);
      $("rail").append(li);
    }
  }

  document.querySelector(".canvas")!.addEventListener("click", () => {
    config = randomize(config, Math.floor(Math.random() * 1e9));
    sync();
  });

  $("save").onclick = async () => {
    const res = await fetch("/lab/timeline/save", { method: "POST", body: JSON.stringify(config) });
    const { path, saves } = await res.json();
    try {
      await navigator.clipboard.writeText(JSON.stringify(config, null, 2));
    } catch {}
    $("saved").textContent = `wrote ${path}`;
    rail(saves);
  };

  $("copy").onclick = () => navigator.clipboard.writeText(JSON.stringify(config, null, 2));

  $("theme").onclick = () => {
    const el = document.documentElement;
    const dark =
      el.dataset.theme === "dark" ||
      (!el.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    el.dataset.theme = dark ? "light" : "dark";
  };

  fetch("/lab/timeline/save").then((r) => r.json()).then(rail);
  sync();
</script>

<style>
  .lab {
    display: grid;
    grid-template-columns: 1fr 19rem;
    min-height: 100vh;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .canvas {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: center;
    gap: 3rem;
    padding: 3rem 2rem;
    cursor: pointer;
  }

  .frame {
    display: grid;
    gap: 1rem;
  }

  .h {
    width: 640px;
  }

  .frame :global(svg) {
    display: block;
    overflow: visible;
  }

  .cap {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 1rem;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    border-left: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .tabs,
  .row {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .seed {
    justify-content: space-between;
  }

  button {
    font: inherit;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  button[aria-pressed="true"],
  .primary {
    background: var(--ink);
    color: var(--paper);
  }

  .panel :global(fieldset) {
    margin: 0;
    padding: 0.5rem 0 0;
    border: 0;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 0.3rem;
  }

  .panel :global(legend) {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--text-label);
  }

  .panel :global(.knob) {
    display: grid;
    grid-template-columns: 7.5rem 1fr 2rem;
    align-items: center;
    gap: 0.5rem;
  }

  .panel :global(.knob.idle) {
    opacity: 0.35;
  }

  .panel :global(select),
  .panel :global(input[type="range"]) {
    width: 100%;
    font: inherit;
  }

  .panel :global(output) {
    text-align: right;
    color: var(--muted);
  }

  .note {
    color: var(--muted);
  }

  #rail {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  #rail :global(button) {
    width: 100%;
    text-align: left;
  }
</style>
