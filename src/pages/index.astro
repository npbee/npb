---
import { getCollection } from "astro:content";
import Page from "../layouts/Page.astro";
import Shell from "../components/system/Shell.astro";
import HomeMark from "../components/system/HomeMark.astro";
import SectionLabel from "../components/system/SectionLabel.astro";
import IndexList from "../components/system/IndexList.astro";
import ProjectRow from "../components/system/ProjectRow.astro";
import { render } from "astro:content";
// Markdown, so formatters can't wrap link text into spaces inside the links
import { Content as Intro } from "../copy/home-intro.md";

const posts = (await getCollection("blog")).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const projects = await Promise.all(
  (await getCollection("projects"))
    .filter((project) => !project.data.draft)
    // The glob loader's order isn't guaranteed; this keeps waveformr first.
    .toSorted((a, b) => b.id.localeCompare(a.id))
    .map(async (project) => ({ project, ...(await render(project)) })),
);
---

<Page title="Nick Ball" description="Software developer based in Portland, OR.">
  <Shell>
    <main>
      <HomeMark />

      <header class="intro">
        <h1>Nick Ball</h1>
        <Intro />
      </header>

      <section class="rows" aria-labelledby="home-posts">
        <SectionLabel id="home-posts">
          <a href="/posts">posts</a>
        </SectionLabel>
        <IndexList posts={posts} />
      </section>

      <section class="rows" aria-labelledby="home-projects">
        <SectionLabel id="home-projects">
          <a href="/projects">projects</a>
        </SectionLabel>
        <ul class="rows plain">
          {projects.map(({ project, Content }) => (
            <ProjectRow name={project.data.title} href={project.data.link}>
              <Content />
            </ProjectRow>
          ))}
        </ul>
      </section>

      <section class="rows" aria-labelledby="home-demos">
        <SectionLabel id="home-demos">
          <a href="/demos">demos</a>
        </SectionLabel>
        <ul class="rows plain">
          <ProjectRow name="Audio Player" href="/demos/audio-player">
            An audio player built with React and React Aria Components.
          </ProjectRow>
          <ProjectRow
            name="Undo / Redo playground"
            href="https://undo-redo-playground.pages.dev/"
          >
            A Linear-like app for exploring undo/redo techniques.
          </ProjectRow>
        </ul>
      </section>
    </main>
  </Shell>
</Page>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-16);
  }

  h1 {
    font-family: var(--font-title);
    font-size: var(--text-name);
    font-weight: 500;
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-name);
  }

  .intro :global(p) {
    max-width: 40ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .intro :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: var(--hair);
    text-underline-offset: 3px;
  }

  main > :global(section) {
    margin-top: var(--space-24);
  }

  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (hover: hover) {
    .intro :global(a:hover) {
      text-decoration-thickness: 2px;
    }

    main :global(.section-label a:hover) {
      color: var(--ink);
    }
  }

  @media (max-width: 47.5rem) {
    main > :global(section) {
      margin-top: var(--space-16);
    }
  }
</style>
