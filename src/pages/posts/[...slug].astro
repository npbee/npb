---
import { getEntry, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import Shell from "../../components/system/Shell.astro";
import Row from "../../components/system/Row.astro";
import ProgressWave from "../../components/system/ProgressWave.astro";
import PostHeader from "../../components/system/PostHeader.astro";
import Prose from "../../components/system/Prose.astro";
import { fullDate, isoDate } from "../../utils/dates";
import { duration, readSeconds } from "../../utils/waveform";

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Not found");
}

const entry = await getEntry("blog", slug);

if (entry === undefined) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);
const readTime = duration(readSeconds(entry.body ?? ""));

const ogImageUrl = new URL(slug + ".og-image.png", Astro.url).toString();
---

<Page
  title={entry.data.title}
  description={entry.data.description}
  ogImageUrl={ogImageUrl}
>
  <Shell current="posts">
    <article>
      <Row narrow="before" class="post">
        <ProgressWave seed={slug} />
        <PostHeader
          title={entry.data.title}
          description={entry.data.description}
        />
        <Prose>
          <Content />
        </Prose>
        <p slot="margin" class="post-notes">
          <time class="post-date" datetime={isoDate(entry.data.date)}
            >{fullDate(entry.data.date)}</time
          >{" · "}{readTime} to read
        </p>
      </Row>
    </article>
  </Shell>
</Page>

<style>
  /* Pinned beside the progress strip, at its height, so the margin below
     is free for wide figures. Its ground reaches back across the gap, so
     figures pass under it as they pass under the strip. Set flush right,
     to end where the wide figures do. */
  :global(.post) > :global(.row-margin) {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 1;
    align-self: start;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: calc(22px + 1.25rem);
    max-width: none;
    margin-left: calc(-1 * var(--gap-drawn));
    padding-left: var(--gap-drawn);
    background: var(--ground);
    white-space: nowrap;
  }

  .post-date {
    color: var(--ink);
  }

  /* Narrow: the notes lead the post, set off as a block note */
  @media (max-width: 47.5rem) {
    :global(.post) > :global(.row-margin) {
      position: static;
      display: block;
      height: auto;
      background: none;
      white-space: normal;
      margin: 0 0 var(--space-6);
      padding-left: 0.875rem;
      border-left: var(--hair) solid var(--rule);
    }
  }
</style>
