---
import { getCollection, getEntry, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import Sheet from "../../components/system/Sheet.astro";
import RunningHead from "../../components/system/RunningHead.astro";
import PostHeader from "../../components/system/PostHeader.astro";
import Prose from "../../components/system/Prose.astro";
import RunningFoot from "../../components/system/RunningFoot.astro";

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Not found");
}

const entry = await getEntry("blog", slug);

if (entry === undefined) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

const oldestFirst = (await getCollection("blog")).toSorted(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const position = oldestFirst.findIndex((post) => post.id === entry.id) + 1;

const ogImageUrl = new URL(slug + ".og-image.png", Astro.url).toString();
---

<Page
  title={entry.data.title}
  description={entry.data.description}
  ogImageUrl={ogImageUrl}
  section="posts"
>
  <Sheet>
    <RunningHead current="posts" />
    <article>
      <PostHeader
        title={entry.data.title}
        description={entry.data.description}
        date={entry.data.date}
        position={position}
        total={oldestFirst.length}
      />
      <Prose>
        <Content />
      </Prose>
    </article>
    <RunningFoot />
  </Sheet>
</Page>

<style>
  article {
    width: 100%;
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: var(--space-8);
  }
</style>
