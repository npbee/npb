---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import Sheet from "../../components/system/Sheet.astro";
import RunningHead from "../../components/system/RunningHead.astro";
import PageTitle from "../../components/system/PageTitle.astro";
import IndexList from "../../components/system/IndexList.astro";
import TitleBlock from "../../components/system/TitleBlock.astro";

const posts = (await getCollection("blog")).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = posts.map((post) => post.data.date.getUTCFullYear());
const range = `${Math.min(...years)}–${Math.max(...years)}`;
---

<Page
  title="Posts | Nick Ball"
  description="Posts by Nick Ball, product engineer based in Portland, OR."
  section="posts"
>
  <Sheet>
    <RunningHead current="posts" />
    <main>
      <PageTitle
        title="posts"
        count={posts.length}
        meta={`${range} · newest first`}
      />
      <IndexList posts={posts} />
    </main>
    <TitleBlock />
  </Sheet>
</Page>

<style>
  main {
    width: 100%;
    display: grid;
    justify-items: center;
    gap: var(--space-8);
  }
</style>
