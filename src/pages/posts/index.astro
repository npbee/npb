---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import Shell from "../../components/system/Shell.astro";
import PageTitle from "../../components/system/PageTitle.astro";
import IndexList from "../../components/system/IndexList.astro";

const posts = (await getCollection("blog")).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Page
  title="Posts | Nick Ball"
  description="Posts by Nick Ball, product engineer based in Portland, OR."
>
  <Shell current="posts">
    <main>
      <PageTitle title="posts" />
      <IndexList posts={posts} />
    </main>
  </Shell>
</Page>

