---
// Temporary: this MDX post embeds Tailwind-styled components, so it keeps
// the old layout on its own route (which wins over [...slug]) until its
// embeds are redesigned. A separate file keeps Tailwind's CSS off the
// redesigned posts.
import BaseLayout from "../../layouts/Base.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("blog", "audio-waveform-scrubber");

if (entry === undefined) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

let formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date(entry.data.date));

const ogImageUrl = new URL(
  "audio-waveform-scrubber.og-image.png",
  Astro.url,
).toString();
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImageUrl={ogImageUrl}
  size="full"
>
  <main class="prose prose-lg prose-gray flex-1 dark:prose-invert prose-headings:text-3xl">
    <div class="space-y-1 text-left">
      <h1
        class="title mb-0 text-balance leading-none"
        style="text-wrap: balance"
      >
        {entry.data.title}
      </h1>
      <p class="text-light text-sm">{formattedDate}</p>
    </div>
    <Content />
  </main>
</BaseLayout>
