---
import Page from "../layouts/Page.astro";
import Shell from "../components/system/Shell.astro";
import Row from "../components/system/Row.astro";
import PageTitle from "../components/system/PageTitle.astro";
import Prose from "../components/system/Prose.astro";
import SectionLabel from "../components/system/SectionLabel.astro";
import CareerList from "../components/system/CareerList.astro";
import NumberedList, {
  type Item,
} from "../components/system/NumberedList.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import avatar from "../assets/avatar.jpeg";
// Markdown, so formatters can't wrap link text into spaces inside the links
import { Content as Intro } from "../copy/about-intro.md";

const posts = new Map(
  (await getCollection("blog")).map((post) => [post.id, post.data.title]),
);

// Each item may point at the posts written about it, by slug, with a short
// label: an item's posts share one line in the margin so every row is the
// same height. The post's full title is the link's tooltip.
const built: [string, [slug: string, label: string][]?][] = [
  ["Workflow engines and dynamic form builders"],
  ["AI-assisted features"],
  ["Rich text editors", [["rich-text-2018", "Rich text on the web"]]],
  ["Undo and redo systems", [["command-based-undo", "Command-based undo"]]],
  ["Drag-and-drop interfaces"],
  ["Interactive flow charts"],
  ["Command palettes"],
  ["Data tables and dashboards"],
  [
    "Complex layouts and animations",
    [
      ["ux-case-study-google-inbox", "Google Inbox"],
      ["css-grid-double-overflow", "Grid overflow"],
    ],
  ],
  ["Design systems"],
  ["Type-safe APIs", [["fresh-hono-rpc", "Fresh + Hono RPC"]]],
  ["Auth flows", [["fresh-supabase-auth", "Supabase auth in Fresh"]]],
  ["Headless CMS sites", [["eleventy-datocms-netlify", "Eleventy + DatoCMS"]]],
  [
    "Audio players and waveform renderers",
    [["audio-waveform-scrubber", "Waveform progress"]],
  ],
  [
    "Build, test, and release pipelines",
    [
      ["sentry-for-single-page-apps", "Sentry for SPAs"],
      ["in-search-of-mocks", "Mocks"],
    ],
  ],
];

const items: Item[] = built.map(([text, refs = []]) => ({
  text,
  links: refs.map(([slug, label]) => {
    const title = posts.get(slug);
    if (!title) throw new Error(`No post "${slug}" for "${text}"`);
    return { label, title, href: `/posts/${slug}` };
  }),
}));
---

<Page
  title="About | Nick Ball"
  description="About Nick Ball, product engineer based in Portland, OR."
>
  <Shell current="about">
    <main>
      <PageTitle title="about" />
      <Row narrow="before" class="intro">
        <Prose>
          <Intro />
        </Prose>
        <div slot="margin" class="intro-margin">
          <Image
            class="photo"
            src={avatar}
            alt="Nick Ball"
            width={224}
            height={224}
            loading="eager"
          />
        </div>
      </Row>
      <section class="rows" aria-labelledby="work">
        <SectionLabel id="work">work</SectionLabel>
        <CareerList />
      </section>
      <NumberedList title="things I've built" {items} />
    </main>
  </Shell>
</Page>

<style>
  /* Sections, not the title and intro, sit a section's distance apart */
  main > :global(section) {
    margin-top: var(--space-24);
  }

  /* Level with the first line of the paragraphs */
  .intro-margin {
    padding-top: 0.3125rem;
  }

  .photo {
    display: block;
    width: 7rem;
    height: auto;
  }

  @media (max-width: 47.5rem) {
    main > :global(section) {
      margin-top: var(--space-16);
    }

    .intro-margin {
      padding: 0;
    }

    .photo {
      margin-bottom: var(--space-6);
    }
  }
</style>
