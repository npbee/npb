---
import Page from "../../layouts/Page.astro";
import Shell from "../../components/system/Shell.astro";
import PageTitle from "../../components/system/PageTitle.astro";
import Prose from "../../components/system/Prose.astro";
import Example from "../../components/system/Example.astro";
import Code from "../../components/system/Code.astro";
import { AudioPlayer } from "../../components/audio-player/player.tsx";
import AudioPlayerRaw from "../../components/audio-player/player.tsx?raw";
---

<Page
  title="Audio player demo | Nick Ball"
  description="Audio player demo built with React and React Aria Components by Nick Ball, product engineer based in Portland, OR."
>
  <Shell current="demos">
    <main>
      <PageTitle title="audio player" />
      <Prose>
        <p>
          This is an audio player built with React that uses
          <a href="https://waveformr.com">Waveformr</a> to render audio waveforms
          as images and <a
            href="https://react-spectrum.adobe.com/react-aria/index.html"
            >React Aria Components</a
          > for accessibility. Check out this <a
            href="/posts/audio-waveform-scrubber">post</a
          > for more details on the waveform progress technique.
        </p>
        <Example label="demo" wide>
          <AudioPlayer client:load />
        </Example>
        <Code code={AudioPlayerRaw} lang="tsx" wide copy />
      </Prose>
    </main>
  </Shell>
</Page>
