---
import Page from "../../layouts/Page.astro";
import Shell from "../../components/system/Shell.astro";
import PageTitle from "../../components/system/PageTitle.astro";
import ProjectRow from "../../components/system/ProjectRow.astro";
import { getDemos } from "../../utils/demos";

const demos = await getDemos();
---

<Page
  title="Demos | Nick Ball"
  description="Demos by Nick Ball, product engineer based in Portland, OR."
>
  <Shell current="demos">
    <main>
      <PageTitle title="demos" />
      <ul class="rows demo-list">
        {demos.map(({ demo, Content }) => (
          <ProjectRow name={demo.data.title} href={demo.data.link}>
            <Content />
          </ProjectRow>
        ))}
      </ul>
    </main>
  </Shell>
</Page>

<style>
  .demo-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
