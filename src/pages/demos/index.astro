---
import Page from "../../layouts/Page.astro";
import Shell from "../../components/system/Shell.astro";
import PageTitle from "../../components/system/PageTitle.astro";
import ProjectRow from "../../components/system/ProjectRow.astro";
---

<Page
  title="Demos | Nick Ball"
  description="Demos by Nick Ball, Software developer based in Portland, OR."
>
  <Shell current="demos">
    <main>
      <PageTitle title="demos" />
      <ul class="rows demo-list">
        <ProjectRow name="Audio Player" href="/demos/audio-player">
          An audio player built with React and Tailwind CSS.
        </ProjectRow>
        <ProjectRow
          name="Undo / Redo playground"
          href="https://undo-redo-playground.pages.dev/"
        >
          A Linear-like app for exploring undo/redo techniques.
        </ProjectRow>
      </ul>
    </main>
  </Shell>
</Page>

<style>
  .demo-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
