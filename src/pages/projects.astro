---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import Shell from "../components/system/Shell.astro";
import PageTitle from "../components/system/PageTitle.astro";
import ProjectRow from "../components/system/ProjectRow.astro";

const projects = await Promise.all(
  (await getCollection("projects"))
    .filter((project) => !project.data.draft)
    // The glob loader's order isn't guaranteed; this keeps waveformr first.
    .toSorted((a, b) => b.id.localeCompare(a.id))
    .map(async (project) => ({ project, ...(await render(project)) })),
);
---

<Page
  title="Projects | Nick Ball"
  description="Projects by Nick Ball, product engineer based in Portland, OR."
>
  <Shell current="projects">
    <main>
      <PageTitle title="projects" />
      <ul class="rows project-list">
        {projects.map(({ project, Content }) => (
          <ProjectRow name={project.data.title} href={project.data.link}>
            <Content />
          </ProjectRow>
        ))}
      </ul>
    </main>
  </Shell>
</Page>

<style>
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
