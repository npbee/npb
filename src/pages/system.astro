---
// A specimen of the design tokens, for reviewing them in a real browser.
// Hidden on production; dev and Vercel previews serve it.
import Page from "../layouts/Page.astro";

if (process.env.VERCEL_ENV === "production") {
  return new Response(null, { status: 404 });
}

const scale = [
  ["--text-note", "mono", 400, "2023.12.29 · 2:11"],
  ["--text-nav", "mono", 400, "about · projects · posts · demos"],
  ["--text-row", "body", 400, "Fresh with a Type-safe Hono API"],
  [
    "--text-body",
    "body",
    400,
    "I’ve always been fascinated by undo/redo in web applications.",
  ],
  ["--text-lead", "body", 400, "Software for the web, made with care."],
  ["--text-name", "body", 500, "Nick Ball"],
  ["--text-title", "body", 500, "Command-based undo for JS apps"],
] as const;

const colors = [
  "--ground",
  "--ground-2",
  "--ink",
  "--muted",
  "--rule",
  "--dim",
  "--accent",
  "--accent-ink",
];
---

<Page title="System | Nick Ball" description="Design token specimen">
  <meta slot="head" name="robots" content="noindex" />

  <main class="specimen">
    <header class="top">
      <span class="wordmark"><span>nick</span> <span>ball</span></span>
      <button type="button" class="theme" id="theme">theme</button>
    </header>

    <section>
      <h2 class="label">type scale</h2>
      <div class="scale">
        {scale.map(([token, face, weight, sample]) => (
          <div class="scale-row">
            <code class="token">{token}</code>
            <span
              class="sample"
              style={`font-family: var(--font-${face}); font-size: var(${token}); font-weight: ${weight}; font-size-adjust: var(--adjust-${face})`}
            >
              {sample}
            </span>
          </div>
        ))}
        <div class="scale-row">
          <code class="token">italic / 600</code>
          <span class="sample" style="font-size: var(--text-body)">
            <em>action-based</em> and <strong>TypeScript</strong>
          </span>
        </div>
      </div>
    </section>

    <section>
      <h2 class="label">color</h2>
      <div class="swatches">
        {colors.map((t) => (
          <div class="swatch">
            <i style={`background: var(${t})`} />
            <code>{t}</code>
            <span data-value={t} />
          </div>
        ))}
      </div>
      <p class="sample-link">
        Body text with <a href="#">a link in the accent</a>.
      </p>
    </section>
  </main>
</Page>

<style>
  .specimen {
    max-width: calc(var(--measure) + var(--margin-gap) + var(--margin));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) var(--space-24);
    display: grid;
    gap: var(--space-16);
  }
  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--hair) solid var(--rule);
    font-size: var(--text-nav);
  }
  .label,
  .token,
  .swatch code,
  .swatch span {
    font-family: var(--font-mono);
    font-size: var(--text-note);
    font-size-adjust: var(--adjust-mono);
    font-weight: 400;
    color: var(--muted);
  }
  section {
    display: grid;
    gap: var(--space-4);
  }
  .theme {
    border: var(--hair) solid var(--rule);
    background: none;
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-note);
    cursor: pointer;
  }
  .scale {
    display: grid;
    gap: var(--space-4);
  }
  .scale-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
  }
  .sample {
    line-height: 1.3;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-4);
  }
  .swatch {
    display: grid;
    gap: var(--space-1);
  }
  .swatch i {
    height: 3rem;
    border: var(--hair) solid var(--rule);
  }
  .sample-link a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: var(--hair);
    text-underline-offset: 3px;
  }
</style>

<script>
  const root = document.documentElement;
  const fill = () => {
    document.querySelectorAll<HTMLElement>("[data-value]").forEach((el) => {
      el.textContent = getComputedStyle(root)
        .getPropertyValue(el.dataset.value!)
        .trim();
    });
  };
  document.getElementById("theme")?.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    const theme = isDark ? "dark" : "light";
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
    fill();
  });
  document
    .querySelectorAll(".sample-link a")
    .forEach((a) => a.addEventListener("click", (e) => e.preventDefault()));
  fill();
</script>
