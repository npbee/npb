---
// A specimen of the design tokens, for reviewing them in a real browser.
// Hidden on production; dev and Vercel previews serve it.
import Page from "../layouts/Page.astro";

if (process.env.VERCEL_ENV === "production") {
  return new Response(null, { status: 404 });
}

const scale = [
  ["--text-label", "mono", 400, "LABEL · 2016–2024"],
  ["--text-meta", "mono", 400, "about · projects · posts · demos"],
  ["--text-mono", "mono", 400, "Fresh with a Type-safe Hono API"],
  ["--text-body-s", "sans", 400, "A tool for building SVG audio waveforms."],
  [
    "--text-body",
    "sans",
    400,
    "I’ve always been fascinated by undo/redo in web applications.",
  ],
  ["--text-h2", "mono", 700, "The command pattern"],
  ["--text-title", "mono", 700, "Command-based undo for JS apps"],
  ["--text-display", "mono", 700, "posts"],
] as const;

const page = ["--paper", "--paper-2", "--ink", "--muted", "--rule"];
const panel = [
  "--panel-frame",
  "--panel-module",
  "--panel-module-hi",
  "--panel-module-lo",
  "--panel-dish",
  "--panel-ink",
  "--panel-muted",
  "--panel-hole",
];
const display = [
  "--display",
  "--display-ink",
  "--display-muted",
  "--display-dim",
  "--display-blue",
  "--display-green",
  "--display-red",
];
const sections = [
  ["about", "--about"],
  ["projects", "--projects"],
  ["posts", "--posts"],
  ["demos", "--demos"],
] as const;
---

<Page title="System | Nick Ball" description="Design token specimen">
  <meta slot="head" name="robots" content="noindex" />

  <main class="specimen">
    <header class="top">
      <span class="wordmark">
        <span>nick</span>
        <span>ball</span>
      </span>
      <span class="label">system specimen</span>
      <button type="button" class="theme" id="theme">
        theme
      </button>
    </header>

    <section>
      <h2 class="label">wordmark</h2>
      <div class="marks">
        <span class="wordmark" style="font-size: var(--text-mono)">
          <span>nick</span>
          <span>ball</span>
        </span>
        <span class="wordmark" style="font-size: var(--text-display)">
          <span>nick</span>
          <span>ball</span>
        </span>
        <div class="screen">
          <span
            class="wordmark"
            style="font-size: var(--text-display); color: var(--display-ink)"
          >
            <span>nick</span>
            <span>ball</span>
          </span>
        </div>
      </div>
    </section>

    <section>
      <h2 class="label">type scale</h2>
      <div class="scale">
        {scale.map(([token, face, weight, sample]) => (
          <div class="scale-row">
            <code class="token">{token}</code>
            <span
              class="sample"
              style={`font-family: var(--font-${face}); font-size: var(${token}); font-weight: ${weight}`}
            >
              {sample}
            </span>
          </div>
        ))}
        <div class="scale-row">
          <code class="token">italic / 600</code>
          <span class="sample" style="font-size: var(--text-body)">
            <em>action-based</em> and <strong>TypeScript</strong>
          </span>
        </div>
      </div>
    </section>

    <section>
      <h2 class="label">page</h2>
      <div class="swatches">
        {page.map((t) => (
          <div class="swatch">
            <i style={`background: var(${t})`} />
            <code>{t}</code>
            <span data-value={t} />
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="label">sections and their accents</h2>
      <div class="sections">
        {sections.map(([name, fill]) => (
          <div class="section-row" data-section={name}>
            <i class="knob" style={`background: var(${fill})`} />
            <span class="name">{name}</span>
            <a href="#" class="link">
              a link
            </a>
            <i class="marker" />
            <i class="bar" />
            <span class="value" data-value="--accent-ink" />
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="label">panel</h2>
      <div class="swatches">
        {panel.map((t) => (
          <div class="swatch">
            <i style={`background: var(${t})`} />
            <code>{t}</code>
            <span data-value={t} />
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="label">display</h2>
      <div class="swatches">
        {display.map((t) => (
          <div class="swatch">
            <i style={`background: var(${t})`} />
            <code>{t}</code>
            <span data-value={t} />
          </div>
        ))}
      </div>
    </section>
  </main>
</Page>

<style>
  .specimen {
    max-width: var(--column);
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) var(--space-24);
    display: grid;
    gap: var(--space-16);
  }
  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--hair) solid var(--ink);
    font-size: var(--text-mono);
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  section {
    display: grid;
    gap: var(--space-4);
  }
  .theme {
    border: var(--hair) solid var(--rule);
    background: none;
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    cursor: pointer;
  }
  .marks {
    display: grid;
    justify-items: center;
    gap: var(--space-8);
  }
  .screen {
    padding: var(--space-8) var(--space-12);
    background: var(--display);
    border-radius: var(--radius-display);
  }
  .scale {
    display: grid;
    gap: var(--space-4);
  }
  .scale-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
  }
  .token,
  .swatch code,
  .swatch span,
  .value {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--muted);
  }
  .sample {
    line-height: 1.3;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-4);
  }
  .swatch {
    display: grid;
    gap: var(--space-1);
  }
  .swatch i {
    height: 3rem;
    border: var(--hair) solid var(--rule);
  }
  .sections {
    display: grid;
  }
  .section-row {
    display: grid;
    grid-template-columns: 1.5rem 6rem auto var(--marker) 3rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: var(--hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }
  .knob {
    width: 1.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 0 0 0 var(--hair) var(--rule);
  }
  .link {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .marker {
    width: var(--marker);
    height: var(--marker);
    background: var(--accent);
  }
  .bar {
    height: var(--bar);
    background: var(--accent);
  }
  .value {
    text-align: right;
  }
</style>

<script>
  const root = document.documentElement;
  const fill = () => {
    document.querySelectorAll<HTMLElement>("[data-value]").forEach((el) => {
      const host = el.closest<HTMLElement>("[data-section]") ?? root;
      el.textContent = getComputedStyle(host)
        .getPropertyValue(el.dataset.value!)
        .trim();
    });
  };
  document.getElementById("theme")?.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    const theme = isDark ? "dark" : "light";
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
    fill();
  });
  document
    .querySelectorAll(".link")
    .forEach((a) => a.addEventListener("click", (e) => e.preventDefault()));
  fill();
</script>
